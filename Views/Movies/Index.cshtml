@model IEnumerable<swift_movies.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

@if (!Model.Any())
{
    <p>No movies available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Year</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.Year</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a class="btn btn-secondary btn-sm" asp-controller="Movies" asp-action="Edit" asp-route-id="@movie.Id">Edit</a>
                            <form asp-controller="Movies" asp-action="Delete" method="post" class="delete-movie-form d-inline">
                                <input type="hidden" name="id" value="@movie.Id" />
                                <button type="submit" class="btn btn-danger btn-sm delete-movie-button" data-title="@movie.Title">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <a class="btn btn-primary" asp-controller="Movies" asp-action="Add">Add Movie</a>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-movie-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    var button = form.querySelector('.delete-movie-button');
                    var movieTitle = button.dataset.title;
                    var confirmed = window.confirm('Are you sure you want to delete the movie "' + movieTitle + '"?');
                    if (!confirmed) {
                        event.preventDefault();
                    }
                });
            });
        });
    </script>
}

