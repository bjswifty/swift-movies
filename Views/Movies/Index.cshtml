@model IEnumerable<swift_movies.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

@if (!Model.Any())
{
    <p>No movies available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Year</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.Year</td>
                </tr>
            }
        </tbody>
    </table>
}
